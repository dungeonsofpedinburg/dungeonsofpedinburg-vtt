_trigger.json

# Ассеты 3D-кубиков копирует postinstall @3d-dice/dice-box
public/assets

# ==========================================
# МЕДИА-АССЕТЫ (Защита от попадания в Git)
# ==========================================

# 1. Постоянное хранилище выпусков (игнорирует всё внутри папок выпусков)
assets/episodes/*
!assets/episodes/.gitkeep

# 2. Временный кэш приложения
assets/cache/*
!assets/cache/.gitkeep

# 3. СТРАХОВКА: Игнорировать старые и любые прямые папки в assets/
assets/scenes/*
assets/characters/*
assets/music/*
assets/soundpad/*
assets/videos/*
assets/equipment/*

# 4. СТРАХОВКА: Игнорировать любые отдельные файлы прямо в корне assets
assets/*.*
!assets/.gitkeep

# Маркеры структуры папок ВСЕГДА остаются в репозитории
!assets/**/.gitkeep

